

# URL base del backend (puede ser local si estás simulando producción en tu máquina)
VITE_MONITORING_API_URL=" http://localhost:3000"

# Endpoints específicos
VITE_SENSORS_ENDPOINT="/sensors"
VITE_READINGS_ENDPOINT="/readings"
VITE_LINKS_ENDPOINT="/links"
VITE_ZONES_ENDPOINT="/zones"
VITE_STATUSES_ENDPOINT="/statuses"

# Metadata del entorno
VITE_ENV="production"
VITE_DEBUG=false
