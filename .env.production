# Environment: Production
# Description: Production environment
# Note: Replace with your actual production API URL

# API Base Configuration
VITE_API_BASE_URL=https://api.pandorasfresh.com/api/v1
VITE_APP_TITLE=Pandora's Fresh

# User Management Context Endpoints
VITE_USER_MANAGEMENT_ENDPOINT_PATH=/users
VITE_AUTH_ENDPOINT_PATH=/auth
VITE_ROLE_MANAGEMENT_ENDPOINT_PATH=/roles

# Inventory Management Context Endpoints
VITE_INVENTORY_ENDPOINT_PATH=/api/v1/inventory
VITE_PRODUCT_ENDPOINT_PATH=/api/v1/products
VITE_CATEGORY_ENDPOINT_PATH=/categories
VITE_SUPPLIER_ENDPOINT_PATH=/suppliers

# IoT Monitoring Context Endpoints
VITE_IOT_MONITORING_ENDPOINT_PATH=/iot
VITE_SENSOR_ENDPOINT_PATH=/sensors
VITE_DEVICE_ENDPOINT_PATH=/devices
VITE_SENSOR_READING_ENDPOINT_PATH=/sensor-readings

# Reporting & Analytics Context Endpoints
VITE_REPORTING_ENDPOINT_PATH=/reporting
VITE_REPORT_ENDPOINT_PATH=/reports
VITE_ANALYTICS_ENDPOINT_PATH=/analytics

# Alert & Notification Context Endpoints
VITE_ALERT_ENDPOINT_PATH=/alerts
VITE_NOTIFICATION_ENDPOINT_PATH=/notifications
VITE_ALERT_RULE_ENDPOINT_PATH=/alert-rules